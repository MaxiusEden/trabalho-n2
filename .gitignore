# Regras gerais do monorepo. Cada pasta (web/, api/) tem o seu .gitignore
# para o que é específico dela.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (DATABASE_URL e JWT_SECRET ficam só aqui)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# skills vendorizadas (regeneradas a partir do skills-lock.json)
/.agents/
/.windsurf/
/.claude/skills/
/.claude/settings.local.json

# arquivos de agente e plano local (nao versionar)
AGENTS.md
CLAUDE.md
PLANO.md
