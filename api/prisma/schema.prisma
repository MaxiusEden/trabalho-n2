generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Perfil de acesso. Todo cadastro nasce USER; ADMIN só pelo seed ou pelo
/// Prisma Studio (nenhuma rota aceita `role` no corpo).
enum Role {
  USER
  ADMIN
}

/// Nível do curso (LAB03, Cursos.Nivel).
enum CourseLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

/// Usuário: o model do PDF "CRUD - NestJS". Acréscimos: as relações
/// `enrollments` e `coursesTaught`, que não criam coluna, e o `role` (etapa 8).
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt()
  role      Role     @default(USER)

  enrollments   Enrollment[]
  coursesTaught Course[]     @relation("CourseInstructor")
}

/// Categoria de cursos e trilhas (LAB03, Categorias). Apagar a categoria só
/// deixa os cursos e as trilhas dela sem categoria.
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
  trilhas Trilha[]
}

/// Trilha de aprendizado. O número de módulos vem de `_count.courses`, nunca
/// é armazenado.
model Trilha {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  categoryId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  courses  Course[]

  @@index([categoryId])
}

/// Curso. Preço em centavos, para não ter erro de arredondamento.
/// `instructorId` e `categoryId` são opcionais: os cursos que já existiam não
/// tinham instrutor nem categoria.
model Course {
  id           Int         @id @default(autoincrement())
  title        String
  description  String
  image        String
  priceCents   Int
  trilhaId     Int?
  instructorId Int?
  categoryId   Int?
  level        CourseLevel @default(INICIANTE)
  publishedAt  DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  trilha      Trilha?      @relation(fields: [trilhaId], references: [id], onDelete: SetNull)
  instructor  User?        @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([trilhaId])
  @@index([instructorId])
  @@index([categoryId])
}

/// Aula do conteúdo programático de um curso.
model Lesson {
  id       Int    @id @default(autoincrement())
  title    String
  duration Int // duração em minutos
  order    Int // posição da aula dentro do curso
  courseId Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
  @@index([courseId])
}

/// Matrícula de um usuário em um curso. O índice único impede matrícula
/// duplicada no próprio banco.
model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
